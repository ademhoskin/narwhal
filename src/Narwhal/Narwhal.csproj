<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>narwhal</AssemblyName>
    <RootNamespace>Narwhal</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Reproducible containerized builds and simplified deployment with Nix flakes and podman.</Description>

    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Narwhal.Tests" />
    <EmbeddedResource Include="../../deploy/systemd/user/narwhal.service" LogicalName="Narwhal.Units.narwhal.service" />
    <EmbeddedResource Include="../../deploy/systemd/user/narwhal-reconcile.service" LogicalName="Narwhal.Units.narwhal-reconcile.service" />
    <EmbeddedResource Include="../../deploy/systemd/user/narwhal-reconcile.timer" LogicalName="Narwhal.Units.narwhal-reconcile.timer" />
    <EmbeddedResource Include="../../deploy/systemd/system/narwhal-guard.service" LogicalName="Narwhal.Units.narwhal-guard.service" />
    <EmbeddedResource Include="../../deploy/systemd/system/narwhal-guard.timer" LogicalName="Narwhal.Units.narwhal-guard.timer" />
  </ItemGroup>
</Project>
