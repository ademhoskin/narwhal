<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>narwhal</AssemblyName>
    <RootNamespace>Narwhal</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Reproducible containerized builds and simplified deployment with Nix flakes and podman.</Description>

    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Narwhal.Tests" />
    <EmbeddedResource Include="../../deploy/systemd/user/narwhald.service" LogicalName="Narwhal.Units.narwhald.service" />
    <EmbeddedResource Include="../../deploy/systemd/user/narwhald-reconcile.service" LogicalName="Narwhal.Units.narwhald-reconcile.service" />
    <EmbeddedResource Include="../../deploy/systemd/user/narwhald-reconcile.timer" LogicalName="Narwhal.Units.narwhald-reconcile.timer" />
    <EmbeddedResource Include="../../deploy/systemd/system/narwhald-guard.service" LogicalName="Narwhal.Units.narwhald-guard.service" />
    <EmbeddedResource Include="../../deploy/systemd/system/narwhald-guard.timer" LogicalName="Narwhal.Units.narwhald-guard.timer" />
  </ItemGroup>

  <Target Name="PublishNarwhald" AfterTargets="Publish">
    <Copy
      SourceFiles="$(PublishDir)$(AssemblyName)"
      DestinationFiles="$(PublishDir)narwhald"
      Condition="Exists('$(PublishDir)$(AssemblyName)')" />
    <Copy
      SourceFiles="$(PublishDir)$(AssemblyName)"
      DestinationFiles="$(PublishDir)narwhal-guard"
      Condition="Exists('$(PublishDir)$(AssemblyName)')" />
    <Exec
      Command="chmod 755 &quot;$(PublishDir)narwhald&quot;"
      Condition="Exists('$(PublishDir)narwhald') and !$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec
      Command="chmod 755 &quot;$(PublishDir)narwhal-guard&quot;"
      Condition="Exists('$(PublishDir)narwhal-guard') and !$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>
</Project>
